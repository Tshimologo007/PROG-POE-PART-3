@model List<RaceCompetitionMVC.Models.EventViewModel>

<h1>Available Race Events</h1>

<p>Explore the races available for participation.</p>

<table class="table">
    <thead>
        <tr>
            <th>Event Name</th>
            <th>Description</th>
            <th>Date</th>
            <th>Type</th>
            <th>Venue</th>
            <th>Race Distance</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.event_Name</td>
                <td>@item.description</td>
                <td>@item.event_Date.ToShortDateString()</td>
                <td>@item.event_Type</td>
                <td>@item.venue</td>
                <td>@item.race_Distance</td>
            </tr>
        }
    </tbody>
</table>


