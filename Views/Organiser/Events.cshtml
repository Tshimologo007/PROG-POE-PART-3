@model List<RaceCompetitionMVC.Models.EventViewModel>

<h1>Manage Race Events</h1>
<p>View and manage all race events.</p>

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">
        @TempData["ErrorMessage"]
    </div>
}

<a asp-controller="Organiser"
   asp-action="Create"
   class="btn btn-success mb-3">
    Create New Event
</a>

<table class="table">
    <thead>
        <tr>
            <th>Event Name</th>
            <th>Description</th>
            <th>Date</th>
            <th>Type</th>
            <th>Venue</th>
            <th>Race Distance</th>

            <th>Actions</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.event_Name</td>
                <td>@item.description</td>
                <td>@item.event_Date.ToShortDateString()</td>
                <td>@item.event_Type</td>
                <td>@item.venue</td>
                <td>@item.race_Distance</td>

                <td>
                    <a asp-controller="Organiser"
                       asp-action="Edit"
                       asp-route-id="@item.eventID"
                       class="btn btn-primary">
                        Edit
                    </a>

                    <a asp-controller="Organiser"
                       asp-action="ManageCategories"
                       asp-route-id="@item.eventID"
                       class="btn btn-info">
                        Manage Categories
                    </a>

                    <a asp-controller="Organiser"
                       asp-action="Results"
                       asp-route-id="@item.eventID"
                       class="btn btn-primary">
                        Enter Results
                    </a>

                    <form asp-controller="Organiser"
                          asp-action="Delete"
                          asp-route-id="@item.eventID"
                          method="post"
                          style="display:inline;">

                        @Html.AntiForgeryToken()

                        <button type="submit"
                                class="btn btn-danger"
                                onclick="return confirm('Are you sure you want to delete this event?');">
                            Delete
                        </button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>
